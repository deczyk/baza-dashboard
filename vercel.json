{
  "crons": [
    { "path": "/api/send-reminders?period=rano", "schedule": "0 5 * * *" },
    { "path": "/api/send-reminders?period=dzien", "schedule": "0 12 * * *" },
    { "path": "/api/send-reminders?period=wieczor", "schedule": "30 18 * * *" },
    { "path": "/api/weekly-summary", "schedule": "0 18 * * 0" }
  ],
  "rewrites": [
    { "source": "/api/werboard-calendar", "destination": "/api/[...route]?route=werboard-calendar" },
    { "source": "/api/werboard-state", "destination": "/api/[...route]?route=werboard-state" },
    { "source": "/api/werboard-google-auth-start", "destination": "/api/google-auth-start?werboard=1" },
    { "source": "/api/debrain/status", "destination": "/api/[...route]?route=debrain/status" },
    { "source": "/api/habit-state", "destination": "/api/[...route]?route=habit-state" },
    { "source": "/api/board/:collection", "destination": "/api/[...route]?route=board/:collection" },
    { "source": "/api/board/:collection/items", "destination": "/api/[...route]?route=board/:collection/items" },
    { "source": "/api/graph", "destination": "/api/[...route]?route=graph" },
    { "source": "/api/graph/:rest*", "destination": "/api/[...route]?route=graph/:rest*" },
    { "source": "/api/automations", "destination": "/api/[...route]?route=automations" },
    { "source": "/api/automations/:rest*", "destination": "/api/[...route]?route=automations/:rest*" }
  ]
}
